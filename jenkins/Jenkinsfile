pipeline {
    agent any

    environment {
        // Update with your Docker Hub username/organization
        DOCKER_IMAGE = "cityfix/bs-pm-2025-team25"
        APP_PORT = "5000"
        // MongoDB connection for testing
        MONGO_TEST_URI = "mongodb://mongo:27017/cityfix_test"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                // Make entrypoint script executable
                sh 'chmod +x docker-entrypoint.sh || true'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    docker.build(DOCKER_IMAGE)
                }
            }
        }

        stage('Run Tests') {
            steps {
                script {
                    // Create a Docker network for the tests
                    sh "docker network create cityfix-test-network || true"
                    
                    // Start a MongoDB container for testing
                    sh "docker run -d --name mongo-test --network cityfix-test-network mongo:5.0"
                    
                    // Run the tests in the application container
                    sh """
                        docker run --rm \
                        --network cityfix-test-network \
                        -e MONGO_URI=mongodb://mongo-test:27017/cityfix_test \
                        ${DOCKER_IMAGE} test \
                        --junitxml=test-results.xml \
                        -v
                    """
                }
            }
            post {
                always {
                    // Stop and remove the MongoDB container
                    sh "docker stop mongo-test || true"
                    sh "docker rm mongo-test || true"
                    
                    // Remove the test network
                    sh "docker network rm cityfix-test-network || true"
                    
                    // Archive test results
                    junit(testResults: 'test-results.xml', allowEmptyResults: true)
                }
            }
        }

        stage('Run Tests with Coverage') {
            steps {
                script {
                    // Create a Docker network for the tests
                    sh "docker network create cityfix-cov-network || true"
                    
                    // Start a MongoDB container for testing
                    sh "docker run -d --name mongo-cov --network cityfix-cov-network mongo:5.0"
                    
                    // Create a directory for coverage results
                    sh "mkdir -p coverage_report"
                    
                    // Run tests with coverage
                    sh """
                        docker run --rm \
                        --network cityfix-cov-network \
                        -e MONGO_URI=mongodb://mongo-cov:27017/cityfix_test \
                        -v \${PWD}/coverage_report:/app/coverage_report \
                        ${DOCKER_IMAGE} testcov
                    """
                }
            }
            post {
                always {
                    // Stop and remove the MongoDB container
                    sh "docker stop mongo-cov || true"
                    sh "docker rm mongo-cov || true"
                    
                    // Remove the test network
                    sh "docker network rm cityfix-cov-network || true"
                    
                    // Publish coverage report
                    publishHTML(target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'coverage_report',
                        reportFiles: 'index.html',
                        reportName: 'Coverage Report'
                    ])
                }
            }
        }

        stage('Push to Registry') {
            when {
                branch 'main'
            }
            steps {
                script {
                    docker.withRegistry('https://registry.hub.docker.com', 'dockerhub-credentials') {
                        docker.image(DOCKER_IMAGE).push("${env.BUILD_NUMBER}")
                        docker.image(DOCKER_IMAGE).push('latest')
                    }
                }
            }
        }

        stage('Deploy to Development') {
            when {
                branch 'develop'
            }
            steps {
                echo "Deploying ${DOCKER_IMAGE}:${env.BUILD_NUMBER} to development..."
                // Example:
                // sh 'ssh deploy@dev-server "docker-compose -f docker-compose.dev.yml pull && docker-compose -f docker-compose.dev.yml up -d"'
            }
        }

        stage('Deploy to Production') {
            when {
                branch 'main'
            }
            steps {
                echo "Deploying ${DOCKER_IMAGE}:latest to production..."
                // Example:
                // sh 'ssh deploy@prod-server "docker-compose -f docker-compose.prod.yml pull && docker-compose -f docker-compose.prod.yml up -d"'
            }
        }
    }

    post {
        always {
            // Clean up local Docker images to save space
            sh "docker rmi ${DOCKER_IMAGE}:latest || true"
            
            // Clean workspace
            cleanWs()
        }
        success {
            echo 'Build and tests succeeded!'
        }
        failure {
            echo 'Build or tests failed!'
            // Optional: Send notification
            // mail to: 'team@example.com', subject: 'Build Failed', body: 'The build has failed. Please check Jenkins.'
        }
    }
}